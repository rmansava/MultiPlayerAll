<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MultiPlayerAll.EnhanceWindow"
        Title="Enhance" Width="900" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#222222">

    <Grid ColumnDefinitions="*,220">

        <!-- Image display -->
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image x:Name="EnhancedImage" Stretch="Uniform" Margin="10"/>
        </ScrollViewer>

        <!-- Controls panel -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="10" Spacing="12">
                <TextBlock Text="Image Enhancement" Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="TimestampLabel" Text="" Foreground="GreenYellow" FontSize="12"/>

                <TextBlock Text="Brightness" Foreground="White" FontSize="12"/>
                <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="0"/>
                <TextBlock x:Name="BrightnessValue" Text="0" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"/>

                <TextBlock Text="Contrast" Foreground="White" FontSize="12"/>
                <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0"/>
                <TextBlock x:Name="ContrastValue" Text="0" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"/>

                <TextBlock Text="Sharpness" Foreground="White" FontSize="12"/>
                <Slider x:Name="SharpnessSlider" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="SharpnessValue" Text="0" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"/>

                <TextBlock Text="Zoom" Foreground="White" FontSize="12"/>
                <Slider x:Name="ZoomSlider" Minimum="100" Maximum="500" Value="100"/>
                <TextBlock x:Name="ZoomValue" Text="100%" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"/>

                <CheckBox x:Name="GrayscaleCheck" Content="Grayscale" Foreground="White"/>
                <CheckBox x:Name="InvertCheck" Content="Invert Colors" Foreground="White"/>

                <Button Content="Reset" Width="80" Click="ResetButton_Click"
                        HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <Button Content="Copy to Clipboard" Width="140" Click="CopyButton_Click"
                        HorizontalAlignment="Center"/>
                <Button Content="Save As..." Width="140" Click="SaveButton_Click"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
