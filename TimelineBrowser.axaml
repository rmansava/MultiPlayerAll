<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MultiPlayerAll.TimelineBrowser"
        Title="Timeline Browser" Width="1200" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="15,10" Spacing="15"
                    HorizontalAlignment="Center">
            <TextBlock Text="Interval:" Foreground="White" VerticalAlignment="Center"/>
            <ComboBox x:Name="IntervalCombo" Width="120" SelectedIndex="2">
                <ComboBoxItem Content="5 seconds" Tag="5"/>
                <ComboBoxItem Content="15 seconds" Tag="15"/>
                <ComboBoxItem Content="30 seconds" Tag="30"/>
                <ComboBoxItem Content="1 minute" Tag="60"/>
                <ComboBoxItem Content="2 minutes" Tag="120"/>
                <ComboBoxItem Content="5 minutes" Tag="300"/>
            </ComboBox>
            <TextBlock Text="Size:" Foreground="White" VerticalAlignment="Center"/>
            <ComboBox x:Name="SizeCombo" Width="100" SelectedIndex="1" SelectionChanged="SizeCombo_SelectionChanged">
                <ComboBoxItem Content="Small" Tag="160"/>
                <ComboBoxItem Content="Medium" Tag="240"/>
                <ComboBoxItem Content="Large" Tag="360"/>
                <ComboBoxItem Content="X-Large" Tag="480"/>
            </ComboBox>
            <Button x:Name="GenerateButton" Content="Generate" Width="80" Click="GenerateButton_Click"/>
            <TextBlock x:Name="StatusText" Text="" Foreground="Gray" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="ThumbnailPanel" Margin="10"
                       HorizontalAlignment="Center"/>
        </ScrollViewer>
    </Grid>
</Window>
