<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MultiPlayerAll.MainWindow"
        Title="MultiPlayer" Width="1280" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="30"
        Background="#222222">

    <Grid ColumnDefinitions="250,5,*">

        <!-- Left Panel: Search and Video List -->
        <Grid Grid.Column="0" Margin="10" RowDefinitions="Auto,Auto,Auto,*">

            <TextBox x:Name="SearchTextBox" Height="30" Margin="0,30,0,10" Grid.Row="0"
                     Watermark="Search videos..." KeyDown="SearchTextBox_KeyDown"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5" Spacing="5">
                <Button x:Name="SearchButton" Content="Search" Height="28" Width="70" Click="SearchButton_Click"/>
                <Button x:Name="ClearButton" Content="Clear" Height="28" Width="70" Click="ClearButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" Spacing="5">
                <Button x:Name="ChooseFileButton" Content="Choose File" Height="28" Click="ChooseFileButton_Click"/>
                <Button x:Name="OpenFileButton" Content="External Player" Height="28" Click="OpenFileButton_Click"/>
            </StackPanel>

            <DataGrid x:Name="VideoDataGrid" Grid.Row="3"
                      AutoGenerateColumns="False" CanUserResizeColumns="True"
                      IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Video" Binding="{Binding FileName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Splitter for resizing the search panel -->
        <GridSplitter Grid.Column="1" Width="5" Background="#444"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Main Content Area -->
        <Grid Grid.Column="2" RowDefinitions="30,Auto,Auto,Auto,*,Auto,Auto">

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="#333333" PointerPressed="TitleBar_PointerPressed">
                <TextBlock Text="MultiPlayer" Foreground="White" FontSize="14" FontWeight="Bold"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" Spacing="0">
                    <TextBlock x:Name="UrlStatusLabel" Text="" Foreground="GreenYellow" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Button Content="Register URL Handler" FontSize="10" Height="22"
                            Background="#444" Foreground="#aaa" BorderThickness="0"
                            Padding="8,0" Margin="0,0,15,0"
                            Click="RegisterUrlHandler_Click"/>
                    <Button Content="―" FontSize="14" Width="30" Height="30"
                            Background="Transparent" BorderThickness="0" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeRestoreButton" Content="❐" FontSize="14" Width="30" Height="30"
                            Background="Transparent" BorderThickness="0" Click="MaximizeRestoreButton_Click"/>
                    <Button Content="✕" FontSize="14" Width="30" Height="30"
                            Background="Transparent" BorderThickness="0" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Control Panel -->
            <WrapPanel Grid.Row="1" Margin="5,5" Orientation="Horizontal">
                <TextBlock Text="Windows" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="NumWindowsComboBox" Width="60" Margin="0,0,5,0" SelectionChanged="NumWindowsComboBox_SelectionChanged">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="9"/>
                </ComboBox>
                <Button x:Name="PlayPauseButton" Content="Play/Pause" Margin="0,0,3,2" Click="PlayPauseButton_Click"/>
                <Button x:Name="StopButton" Content="Stop" Margin="0,0,3,2" Click="StopButton_Click"/>
                <Button Content="&lt;&lt;" Width="30" Margin="0,0,1,2" Click="SpeedDownButton_Click"/>
                <TextBlock x:Name="SpeedLabel" Text="1x" Width="25" VerticalAlignment="Center"
                           Foreground="White" TextAlignment="Center"/>
                <Button Content="&gt;&gt;" Width="30" Margin="0,0,3,2" Click="SpeedUpButton_Click"/>
                <Button x:Name="FrameItButton" Content="Frame It" Margin="0,0,3,2" Click="FrameItButton_Click"/>
                <Button x:Name="ScreenshotButton" Content="Screenshot" Margin="0,0,3,2" Click="ScreenshotButton_Click"/>
                <Button x:Name="TimelineButton" Content="Timeline" Margin="0,0,3,2" Click="TimelineButton_Click"/>
                <Button x:Name="EnhanceButton" Content="Enhance" Margin="0,0,3,2" Click="EnhanceButton_Click"/>
                <Button x:Name="MuteButton" Content="UnMute" Margin="0,0,3,2" Click="MuteButton_Click"/>
                <Button x:Name="VolumeDownButton" Content="Vol-" Margin="0,0,1,2" Click="VolumeDownButton_Click"/>
                <TextBlock x:Name="VolumeLabel" Text="100" Width="30" VerticalAlignment="Center"
                           Foreground="White" TextAlignment="Center"/>
                <Button x:Name="VolumeUpButton" Content="Vol+" Margin="0,0,0,2" Click="VolumeUpButton_Click"/>
            </WrapPanel>

            <!-- Skip Buttons Row -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,0" Spacing="2">
                <Button Content="-60" Tag="-60" Height="30" Width="45" Click="SkipButton_Click"/>
                <Button Content="-30" Tag="-30" Height="30" Width="45" Click="SkipButton_Click"/>
                <Button Content="-15" Tag="-15" Height="30" Width="45" Click="SkipButton_Click"/>
                <Button Content="-5" Tag="-5" Height="30" Width="40" Click="SkipButton_Click"/>
                <Button Content="-1" Tag="-1" Height="30" Width="40" Click="SkipButton_Click"/>
                <Button Content="+1" Tag="1" Height="30" Width="40" Click="SkipButton_Click"/>
                <Button Content="+5" Tag="5" Height="30" Width="40" Click="SkipButton_Click"/>
                <Button Content="+15" Tag="15" Height="30" Width="45" Click="SkipButton_Click"/>
                <Button Content="+30" Tag="30" Height="30" Width="45" Click="SkipButton_Click"/>
                <Button Content="+60" Tag="60" Height="30" Width="45" Click="SkipButton_Click"/>
                <TextBlock Text="  " VerticalAlignment="Center"/>
                <RadioButton x:Name="StreamRadio" Content="Stream" Foreground="White"
                             IsChecked="True" GroupName="PlayMode" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <RadioButton x:Name="DownloadRadio" Content="Download" Foreground="White"
                             GroupName="PlayMode" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Slider -->
            <Slider x:Name="PositionSlider" Grid.Row="3" Margin="10,5"
                    Minimum="0" Maximum="100"
                    ValueChanged="PositionSlider_ValueChanged"/>

            <!-- Video Display Container -->
            <Grid x:Name="VideoContainer" Grid.Row="4" Background="Black" ClipToBounds="True">
                <!-- Loading overlay (hidden by default) -->
                <Border x:Name="LoadingOverlay" IsVisible="False" Background="#CC000000" ZIndex="99"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <TextBlock x:Name="LoadingStatusText" Text="Loading video..."
                                   Foreground="White" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LoadingDetailText" Text=""
                                   Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Download overlay (hidden by default) -->
                <Border x:Name="DownloadOverlay" IsVisible="False" Background="#DD222222" ZIndex="100"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="8" Padding="30,20">
                    <StackPanel Spacing="10" MinWidth="350">
                        <TextBlock x:Name="DownloadStatusText" Text="Downloading..."
                                   Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100"
                                     Height="20" Foreground="DodgerBlue"/>
                        <TextBlock x:Name="DownloadDetailText" Text=""
                                   Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                        <Button x:Name="CancelDownloadButton" Content="Cancel" Width="80"
                                HorizontalAlignment="Center" Click="CancelDownloadButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="6" Background="#1a1a1a" Padding="10,4">
                <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="Gray" FontSize="11"/>
            </Border>

        </Grid>
    </Grid>
</Window>
